# model3d-studio 환경변수 예시
#
# 이 파일은 커밋한다. 실제 값이 든 `.env` 는 **절대 커밋하지 않는다** (CLAUDE.md §3).
# 루트에 `.env` 를 만들고 아래 값을 채우세요.

# ── Supabase ──────────────────────────────────────────────────────────────
# 웹(브라우저)은 publishable key 만 쓴다. service key 를 여기 넣으면 앱이 거부한다.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# 워커(로컬/서버)는 service key 로 RLS 를 우회한다. 브라우저 번들에 넣지 말 것.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxx

# ── LLM ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ── 작업 디렉터리 (재생성 가능한 산출물, .gitignore 대상) ─────────────────
M3D_WORK_DIR=work

# ── 샘플 도면 세트 원본 (사용자마다 다름 — 커밋 금지) ─────────────────────
# 이름 규칙: M3D_SAMPLE_SOURCE_ + <set_id 대문자, '-'는 '_'>
# 등록된 세트는 `m3d samples list` 로 확인.
#
# ⚠ Windows 경로를 **큰따옴표로 감싸지 마세요.**
#    dotenv 는 큰따옴표 안에서 백슬래시를 이스케이프로 해석합니다. 실측:
#      M3D_X="D:\Projects\new\test"   →  D:\Projects<개행>ew<탭>est   (경로 깨짐)
#      M3D_X=D:\Projects\new\test     →  D:\Projects\new\test        (정상)
#      M3D_X='D:\Projects\new\test'   →  D:\Projects\new\test        (정상)
#    따옴표 없이 쓰거나(권장) 작은따옴표를 쓰세요. 슬래시(D:/Projects/...)도 됩니다.
#    공백·한글이 들어간 경로도 따옴표 없이 그대로 쓰면 됩니다.
#
# 이 경로는 **읽기 전용**으로만 열립니다 — ingest 는 복사만 하고 원본에 쓰지 않습니다
# (CLAUDE.md §2).
M3D_SAMPLE_SOURCE_AB1_P4P5=D:\Projects\Inspection\mbi_app_v2\assets\drawings_organized\_정밀조사패키지_P4P5
